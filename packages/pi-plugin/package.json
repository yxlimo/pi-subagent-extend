{
  "name": "pi-subagent-extend",
  "version": "0.1.0",
  "description": "Everything a pi session needs around subagents: scope what a delegated subagent may touch, and keep main-agent-only context out of child prompts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "subagents",
    "sandbox",
    "allowlist",
    "agents-md"
  ],
  "pi": {
    "extensions": [
      "src/index.ts",
      "src/main-context.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:helper": "mkdir -p bin && cargo build --release --manifest-path ../helper/Cargo.toml && cp ../helper/target/release/pi-subagent-extend-helper bin/",
    "pretest": "pnpm run build:helper",
    "test": "node test/extension.test.mjs && node test/context.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "skills",
    "bin"
  ]
}
