{
  "name": "pi-subagent-extend",
  "version": "0.1.0",
  "description": "Everything a pi session needs around subagents: scope what a delegated subagent may touch, and keep main-agent-only context out of child prompts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxlimo/pi-subagent-extend.git",
    "directory": "packages/pi-plugin"
  },
  "homepage": "https://github.com/yxlimo/pi-subagent-extend#readme",
  "bugs": "https://github.com/yxlimo/pi-subagent-extend/issues",
  "keywords": [
    "pi",
    "pi-extension",
    "subagents",
    "sandbox",
    "allowlist",
    "agents-md"
  ],
  "pi": {
    "extensions": [
      "src/index.ts",
      "src/main-context.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:helper": "mkdir -p bin && cargo build --release --manifest-path ../helper/Cargo.toml && cp ../helper/target/release/pi-subagent-extend-helper bin/",
    "pretest": "pnpm run build:helper",
    "test": "pnpm run lint && node test/extension.test.ts && node test/context.test.ts && node test/mock-session.test.ts",
    "test:mock": "node test/mock-session.test.ts",
    "test:llm": "node test/e2e.test.ts",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-unicorn": "^79.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  },
  "files": [
    "src",
    "skills",
    "bin"
  ]
}
