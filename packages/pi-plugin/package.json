{
  "name": "pi-allow-reads",
  "version": "0.1.0",
  "description": "Scope what a pi session (primarily a subagent) may touch: reject every tool call outside the task scope",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-extension",
    "subagents",
    "sandbox",
    "allowlist"
  ],
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "build:helper": "mkdir -p bin && cargo build --release --manifest-path ../helper/Cargo.toml && cp ../helper/target/release/pi-allow-reads-helper bin/",
    "pretest": "pnpm run build:helper",
    "test": "node test/extension.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "skills",
    "bin"
  ]
}
